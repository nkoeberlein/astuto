  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title><%= content_for(:title) || AstutoProject::NAME %></title>
    <%= render 'layouts/plain_styles' %>
  </head>
  <body>
    <main class="notice-page">
      <%= yield %>
    </main>
  </body>
</html>
