#!/usr/bin/env ruby
# Fails only on critical advisories in the legacy UI's npm packages (yarn.lock).
# `yarn audit` itself exits non-zero for any severity, even with --level.
# The legacy UI is replaced in v2, so lower severities are not fixed there.
require "json"

output = IO.popen(%w[yarn audit --json], err: File::NULL, &:read)
summary = output.lines.map { |line| JSON.parse(line) rescue nil }.compact.find { |e| e["type"] == "auditSummary" }
abort "yarn audit returned no summary" unless summary

counts = summary.dig("data", "vulnerabilities")
puts counts.map { |level, n| "#{level}: #{n}" }.join(", ")
exit(counts["critical"].to_i.zero? ? 0 : 1)
